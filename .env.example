# Browser-safe Supabase key (Dashboard → Settings → API → publishable/anon key)
SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 — create bucket + API token in Cloudflare dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Supabase (server-only — never expose SUPABASE_SECRET_KEY to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# If tables return "permission denied", run in the SQL editor:
# GRANT ALL ON ALL TABLES IN SCHEMA public TO service_role;
# GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO service_role;
# GRANT USAGE ON SCHEMA public TO service_role;

# Optional: for `bun run gen:types`
SUPABASE_PROJECT_ID=your-project-id

# Staging: set to "true" to allow source_type override on POST /api/sessions
STAGING_MODE=true

# Survey URL and debrief copy are managed in the admin panel at /admin/handoff-settings.
# Optional env fallbacks if platform_settings rows are missing (pre-migration only):
# SURVEY_URL=https://survey.example.com?session_id={session_id}
# DEBRIEF_TITLE=Study Debrief
# DEBRIEF_BODY=Thank you for participating. Your responses did not alter the content shown.
# DEBRIEF_WITHDRAWAL=To withdraw your data, contact the research team at research@example.com.
# DEBRIEF_CONTACT=research@example.com

# Bearer token for GET /api/export
EXPORT_API_KEY=change-me-in-production
